{
  "version": "0.2.0",
  "configurations": [
    {
      "request": "launch",
      "name": "GraphQL API",
      "type": "node",
      "program": "${workspaceFolder}/graphql/main.ts",
      "cwd": "${workspaceFolder}/graphql/",
      "env": {},
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--enable-source-maps",
        "--import",
        "temporal-polyfill/global",
        "--import",
        "./instrument.ts",
        "--inspect-wait=127.0.0.1:9228"
      ],
      "args": ["--allow-file-kv"]
    },
    {
      "request": "launch",
      "name": "GraphQL worker",
      "type": "node",
      "program": "${workspaceFolder}/graphql/worker.ts",
      "cwd": "${workspaceFolder}/graphql/",
      "env": {},
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--enable-source-maps",
        "--import",
        "temporal-polyfill/global",
        "--import",
        "./instrument.ts",
        "--inspect-wait=127.0.0.1:9230"
      ]
    }
  ]
}
