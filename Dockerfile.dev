FROM docker.io/debian:13-slim

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV NO_WATCHMAN=1

RUN apt-get update && apt-get -y --no-install-recommends install \
  build-essential ca-certificates curl ffmpeg git jq && \
  dpkg --compare-versions \
    "$(dpkg-query -W -f='${Version}' ca-certificates)" ge 20250419+deb13u1 && \
  rm -rf /var/lib/apt/lists/*

ENV MISE_DATA_DIR="/mise"
ENV MISE_CONFIG_DIR="/mise"
ENV MISE_CACHE_DIR="/mise/cache"
ENV MISE_STATE_DIR="/mise/state"
ENV MISE_INSTALL_PATH="/usr/local/bin/mise"
ENV npm_config_fetch_retries="5"
ENV npm_config_fetch_retry_maxtimeout="120000"
ENV npm_config_fetch_timeout="300000"
ENV PATH="/mise/shims:$PATH"

# mise's bundled npm CA store needs the eMudhra distrust update too.
RUN curl -fsSL https://mise.run | MISE_VERSION=v2026.10.17 sh

WORKDIR /app
COPY mise.toml /app/mise.toml
RUN mise trust && mise install

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml /app/
COPY ai/package.json /app/ai/package.json
COPY federation/package.json /app/federation/package.json
COPY graphql/package.json /app/graphql/package.json
COPY models/package.json /app/models/package.json
COPY runtime/package.json /app/runtime/package.json
COPY web-next/package.json /app/web-next/package.json
# asset-cdn (the Cloudflare Worker) is a pnpm workspace member, so its manifest
# must be present for `--frozen-lockfile` to validate against the lockfile.
COPY asset-cdn/package.json /app/asset-cdn/package.json
COPY patches /app/patches

RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store \
  npm_config_ignore_scripts=true mise deps install pnpm --force

COPY . /app

EXPOSE 3000 8080
CMD ["mise", "run", "dev:web-next"]
