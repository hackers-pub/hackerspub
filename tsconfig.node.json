{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rewriteRelativeImportExtensions": true,
    "types": ["node", "temporal-polyfill/global"]
  },
  "include": [
    "ai/**/*.ts",
    "federation/**/*.ts",
    "graphql/**/*.ts",
    "models/**/*.ts",
    "runtime/**/*.ts",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "types/**/*.d.ts",
    "lint-plugins/**/*.ts"
  ]
}
