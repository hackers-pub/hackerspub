{
	auto_https off
	servers :8000 {
		trusted_proxies static private_ranges
		trusted_proxies_strict
	}
}

(proxy_headers) {
	header_up X-Forwarded-For {client_ip}
	header_up X-Forwarded-Proto https
}

:8000 {
	route {
		@internal_health path /health
		handle @internal_health {
			respond 404
		}

		@associations path /.well-known/assetlinks.json /.well-known/apple-app-site-association
		handle @associations {
			reverse_proxy graphql:8080 {
				import proxy_headers
			}
		}

		@protocol path /.well-known/* /ap/* /nodeinfo/*
		handle @protocol {
			reverse_proxy protocol:8081 {
				import proxy_headers
			}
		}

		@api path /graphql /graphql/* /medium-uploads /medium-uploads/* /media/*
		handle @api {
			reverse_proxy graphql:8080 {
				import proxy_headers
			}
		}

		handle {
			reverse_proxy web-next:3000 {
				import proxy_headers
			}
		}
	}
}
